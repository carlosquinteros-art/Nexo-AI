# ============================================================================
# NEXO — Variables de entorno (ejemplo)
#
# Copia este archivo como `.env.local` y reemplaza los valores.
# `.env.local` NUNCA debe subirse al repositorio (ya está en .gitignore).
#
# IMPORTANTE
#   Solo las variables con prefijo VITE_ llegan al navegador. Por eso aquí
#   únicamente van datos públicos por diseño:
#     - La URL del proyecto es pública.
#     - La anon key es pública: quien protege los datos es Row Level Security.
#   NUNCA pongas la clave de servicio ni claves de APIs de IA en este archivo
#   con prefijo VITE_. Esas van en el servidor (Edge Functions → Secrets).
# ============================================================================

# --- Supabase (público, va al navegador) ------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo.reemplazar

# --- Aplicación --------------------------------------------------------------
VITE_APP_NAME=Nexo
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_TIMEZONE=America/Santiago
VITE_DEFAULT_LOCALE=es-CL

# URL a la que Supabase redirige tras confirmar el correo o restablecer la clave.
# Debe estar registrada en Supabase → Authentication → URL Configuration.
VITE_AUTH_REDIRECT_URL=http://localhost:5173

# --- Solo servidor ------------------------------------------------------------
# Estas NO van en este archivo ni en ninguno del repositorio. Se cargan como
# secretos de Supabase con:
#
#   supabase secrets set NOMBRE=valor
#
# Las que usa Nexo hoy o en el futuro:
#   · La clave de servicio de Supabase (rol privilegiado): jamás en el navegador.
#     Solo se usa dentro de Edge Functions, y Supabase la inyecta sola.
#   · La API key del modelo de IA, para la función `nexo-ai`.
#   · Las claves VAPID, cuando se activen las notificaciones push.
