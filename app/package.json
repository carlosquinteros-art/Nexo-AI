{
  "name": "nexo",
  "private": true,
  "version": "1.0.0",
  "description": "Asistente personal de trabajo, universidad y vida personal.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
